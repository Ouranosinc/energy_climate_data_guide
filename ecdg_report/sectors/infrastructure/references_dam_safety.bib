@article{Li2024,
title = {Estimation of probable maximum precipitation (PMP) in Hong Kong under future changing climate based on statistical downscaling},
journal = {Urban Climate},
volume = {55},
pages = {101988},
year = {2024},
issn = {2212-0955},
doi = {https://doi.org/10.1016/j.uclim.2024.101988},
url = {https://www.sciencedirect.com/science/article/pii/S2212095524001846},
author = {San Shing Chan and Jianfeng Li and Tsz-cheung Lee},
keywords = {Probable maximum precipitation (PMP), Climate change impact, Depth-area-duration analysis, Statistical downscaling},
abstract = {Climate change impacts on probable maximum precipitation (PMP), the theoretical greatest rainfall depth for a specific area at the city level, are still unclear. In this study, we evaluate future changes in 24-h PMP in Hong Kong by statistically downscaling the outputs of five CMIP6 Global Climate Models (GCMs) under three Shared Socioeconomic Pathways (SSP) scenarios (i.e., SSP126, SSP370, and SSP585). The downscaling results demonstrate the methods' satisfactory ability to estimate PMP values in the reference period (1986–2014). The projections exhibit increases in annual maximum daily precipitation in the future (2071–2099) with the largest average increment of 28.8% in SSP585. The multi-model ensemble mean shows the increases in the 100-year return period annual maximum daily dew point temperature (Wm) and the dew point temperature of annual maximum daily precipitation (Ws) in the future. Meanwhile, larger changes in Wm relative to Ws lead to a rise in the moisture maximization ratio (Rm). With the combined effects of the changes in precipitation and dew point temperature, the 24-h PMP estimates corresponding to 10 km2 in the SSP126, SSP370, and SSP585 scenarios are expected to increase, reaching 1724.6 mm (30.8% increase), 1435 mm (8.3%), and 1788.1 mm (35.6%), respectively.}
}
