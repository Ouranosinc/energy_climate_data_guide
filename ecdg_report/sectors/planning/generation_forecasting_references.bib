@article{phukoetphim_knowledge_2014,
	title = {Knowledge {Extraction} from {Artificial} {Neural} {Networks} for {Rainfall}-{Runoff} {Model} {Combination} {Systems}},
	volume = {19},
	issn = {1084-0699, 1943-5584},
