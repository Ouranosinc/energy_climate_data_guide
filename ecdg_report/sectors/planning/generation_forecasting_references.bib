\_eprint: https://doi.org/10.1080/02626667.2020.1839080},
	keywords = {uncertainty, streamflow, human influences, hydrological modelling, impacted catchments, naturalization methods},
	pages = {12--36},
	file = {Full Text PDF:C\:\\Users\\sheikm33\\Zotero\\storage\\JX8Y8BE3\\Terrier et al. - 2021 - Streamflow naturalization methods a review.pdf:application/pdf},
}

