	keywords = {Model uncertainty, Heterogenous models, Impulse responses, Markov-switching mixture, Parameter uncertainty, Policy analysis, Regime-dependent weights},
	pages = {167--184},
	file = {Full Text:C\:\\Users\\sheikm33\\Zotero\\storage\\YU4FEXHB\\Waggoner and Zha - 2012 - Confronting model misspecification in macroeconomi.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\sheikm33\\Zotero\\storage\\IEDNKBZD\\S0304407612001601.html:text/html},
}

