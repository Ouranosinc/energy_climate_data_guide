	keywords = {Ethiopia, Lake Tana Basin, Model comparison, Semi-distributed model, Simple conceptual model},
	pages = {49--66},
	file = {ScienceDirect Snapshot:C\:\\Users\\sheikm33\\Zotero\\storage\\CJF3NFNN\\S2214581816301409.html:text/html},
}

