
@article{granger_improved_1984,
	title = {Improved methods of combining forecasts},
	volume = {3},
	issn = {0277-6693, 1099-131X},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/for.3980030207},
	doi = {10.1002/for.3980030207},
	abstract = {It is well known that a linear combination of forecasts can outperform individual forecasts. The common practice, however, is t o obtain a weighted average of forecasts, with the weights adding up to unity. This paper considers three alternative approaches to obtaining linear combinations. It is shown that the best method is to add a constant term and not to constrain the weights to add to unity. These methods are tested with data on forecasts of quarterly hog prices, both within and out of sample. It is demonstrated that the optimum method proposed here is superior to the common practice of letting the weights add up to one.},
	language = {en},
	number = {2},
	urldate = {2023-12-10},
	journal = {Journal of Forecasting},
	author = {Granger, Clive W. J. and Ramanathan, Ramu},
	month = apr,
	year = {1984},
	pages = {197--204},
	file = {Granger and Ramanathan - 1984 - Improved methods of combining forecasts.pdf:C\:\\Users\\sheikm33\\Zotero\\storage\\KGKWMQAH\\Granger and Ramanathan - 1984 - Improved methods of combining forecasts.pdf:application/pdf},
}

@article{cavadias_combination_1986,
