Publisher: Copernicus GmbH},
	keywords = {GLUE, HYMOD, river discharge, Yalong River basin},
	pages = {180--185},
	file = {Full Text PDF:C\:\\Users\\sheikm33\\Zotero\\storage\\6DQ5HC7N\\Quan et al. - 2015 - Evaluation of the HYMOD model for rainfall–runoff .pdf:application/pdf},
