isbn = {03151468 (ISSN)},
issn = {0315-1468},
journal = {Canadian Journal of civil engineering},
keywords = {digital elevation model,journal translation,kriging with external drift,root-mean-square errors,snow water equivalent},
pages = {289--297},
title = {{Apport de la technique du krigeage avec d{\'{e}}rive externe pour une cartographie raisonn{\'{e}}e de l ' {\'{e}}quivalent en eau de la neige : Application aux bassins de la rivi{\`{e}}re Gatineau}},
