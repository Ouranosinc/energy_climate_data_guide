journal = {Hydrology and Earth System Sciences Discussions},
number = {3},
pages = {4485--4534},
title = {{Copula based multisite model for daily precipitation simulation}},
url = {http://www.hydrol-earth-syst-sci-discuss.net/6/4485/2009/},
volume = {6},
year = {2009}
}
