title = {{Design of an Optimal Soil Moisture Monitoring Network Using SMOS Retrieved Soil Moisture}},
url = {http://ieeexplore.ieee.org/lpdocs/epic03/wrapper.htm?arnumber=7041197},
volume = {53},
year = {2015}
}
